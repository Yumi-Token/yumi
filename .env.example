# ─────────────────────────────────────────────────────────────
#  이 파일을 .env 로 복사한 뒤 값을 채우세요.
#
#  .env 는 .gitignore 에 들어 있습니다. 절대 커밋하지 마세요.
#  그리고 이 파일(.env.example)에는 실제 값을 쓰지 마세요.
# ─────────────────────────────────────────────────────────────

# 배포 지갑 개인키 (0x 포함)
#
#  경고 — 이 항목이 이 프로젝트에서 가장 위험한 한 줄입니다.
#
#  - 평소 쓰는 지갑을 쓰지 마세요. 이 프로젝트 전용 지갑을 새로 만드세요.
#  - 테스트넷 배포용 키와 메인넷 배포용 키를 분리하세요.
#  - 이 값을 AI 도구·채팅·이슈·스크린샷에 절대 붙여넣지 마세요.
#    (저를 포함해서입니다. 제가 물어봐도 주지 마세요.)
#  - 메인넷 단계에서는 하드웨어 지갑 + --ledger 옵션 사용을 권장합니다.
#
#  참고: 북한 연계 공격자가 한국 크립토 개발자를 표적 사회공학으로 노립니다.
#  2025년 전체 탈취액 34억 달러 중 20.2억 달러가 이들 소행으로 추정됩니다.
#  개발자 노트북과 키 관리가 컨트랙트 코드보다 큰 리스크 표면입니다.
#  ── 더 나은 방법: 이 줄을 아예 비우고 암호화 키스토어를 쓰세요 ──
#
#    cast wallet import deployer --interactive
#    forge script script/Deploy.s.sol --account deployer --rpc-url base_sepolia --broadcast
#
#  키스토어를 만들어놓고 여기 평문을 남기면 의미가 없습니다. 둘 중 하나만 쓰세요.
PRIVATE_KEY=

# 타임락에 예약을 걸 수 있는 주소 = Safe 2-of-3 멀티시그 (D-019)
#
#  ⚠️ 개인 지갑 주소를 넣지 마세요. 반드시 Safe 컨트랙트 주소여야 합니다.
#     배포 스크립트가 코드 크기를 검사해서 EOA면 배포를 거부합니다.
#
#  ⚠️ 비워두면 배포가 실패합니다. 이건 버그가 아니라 의도입니다 —
#     예전에는 비우면 배포 지갑이 그대로 운영자가 됐는데,
#     그 구조에서는 키 하나가 예약과 취소를 동시에 쥐고
#     유출 시 도난이 아니라 「영구 동결」이 일어납니다. (D-007)
#
#  만드는 법: app.safe.global → Base 네트워크 → 서명자 3개, 정족수 2
#            자세한 절차는 docs/HANDOVER.md 「Safe 2-of-3 만들기」
#
#  이 주소가 할 수 있는 것은 「7일 뒤 실행될 작업을 예약하는 것」뿐입니다.
#  실행은 누구나 할 수 있고(키 분실 시 물량이 영구히 잠기는 것을 막기 위해),
#  예약 없이 움직이는 것은 아무도 할 수 없습니다.
SAFE_ADDRESS=

# RPC 엔드포인트
# 공개 엔드포인트로 시작해도 되고, 나중에 Alchemy/QuickNode 무료 티어로 바꾸면 됩니다.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Basescan API 키 — 소스 검증에 필요합니다.
# https://etherscan.io 가입 후 API Keys 에서 무료로 발급받으세요.
#
#  Etherscan 통합 API(V2) 키 하나가 Base 와 Base Sepolia 를 모두 커버합니다.
#  basescan.org 에서 따로 받을 필요가 없습니다.
#  foundry.toml 이 chain id(84532 / 8453)를 붙여 보냅니다.
# 검증되지 않은 컨트랙트는 아무도 신뢰하지 않습니다.
ETHERSCAN_API_KEY=
