# ─── 절대 커밋하면 안 되는 것 ───────────────────────────────
.env
.env.*
!.env.example
*.key
*.pem
keystore/
secrets/

# ─── 배포 기록 ───────────────────────────────────────────────
# broadcast/ 에는 실제 배포 트랜잭션 기록이 남습니다.
# 주소와 트랜잭션 해시는 공개해도 되는 정보이므로 커밋하는 편이
# 오히려 좋습니다 — 기록이 곧 이 프로젝트의 자산입니다.
# 다만 dry-run 결과는 제외합니다.
broadcast/**/dry-run/

# ─── 빌드 산출물 ─────────────────────────────────────────────
out/
cache/
docs/book/

# ─── 에디터·OS ───────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
*.swp
node_modules/

# ─── 작업 지시서 (저장소 산출물이 아님) ─────────────────────
# Cowork 세션에서 넘어온 프롬프트. 결정과 근거는 docs/DECISIONS.md 에
# 남으므로 여기 원본까지 커밋할 이유가 없습니다.
Claude/

# ─── 채널 운영 스크립트 (저장소 산출물이 아님) ──────────────
# 홀더·검증과 무관하고 서버 구조만 노출합니다.
scripts/discord_setup.py
scripts/__pycache__/

# ─── 주간 기록 초안 (재생성 가능) ───────────────────────────
# 한 명령으로 다시 만들 수 있고, 커밋되면 「자동 수집 초안」 경고가
# 저장소에 남아 발행본과 혼동됩니다.
log/_draft-*.md